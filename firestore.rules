rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test Connection Document
    match /test/{testId} {
      allow read, write: if true;
    }

    // Application Settings (Read allowed publicly for initial theme/school name, Write requires Auth)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        request.resource.data.id is string &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 200
      );
      allow delete: if isSignedIn();
    }

    // Curriculum Collection
    match /curriculum/{subjectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Teacher Marks Collection
    match /teacherMarks/{markId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Audit and Sync Logs
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Catch-all Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
